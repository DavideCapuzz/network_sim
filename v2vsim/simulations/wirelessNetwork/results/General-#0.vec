attr experiment General
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network v2vsim.simulations.wirelessNetwork.WirelessNetwork
attr processid 122291
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../../../packages/inet/images
config network v2vsim.simulations.wirelessNetwork.WirelessNetwork
config description "DIAGNOSTIC - Maximum logging"
config sim-time-limit 20s
config cmdenv-express-mode false
config **.cmdenv-log-level trace
config *.configurator.addStaticAnycastRoutes true
config **.arp.typename GlobalArp
config **.ipv4.ip.limitedBroadcast true
config *.numRobots 2
config *.configurator.config "xml(\"<config><interface hosts='**' address='10.0.0.x' netmask='255.255.255.0'/></config>\")"
config **.robot[*].ipv4.ip.directBroadcastInterfaces "\"wlan0\""
config *.robot[*].mobility.typename StationaryMobility
config *.robot[0].mobility.initialX 100m
config *.robot[0].mobility.initialY 300m
config *.robot[1].mobility.initialX 150m
config *.robot[1].mobility.initialY 300m
config *.robot[*].numApps 1
config *.robot[*].app[0].typename v2vsim.RobotApp
config *.robot[*].app[0].localPort 5000
config *.robot[*].app[0].remotePort 5000
config *.robot[*].numWlanInterfaces 1
config *.robot[*].wlan[0].typename Ieee80211Interface
config *.robot[*].wlan[0].radio.typename Ieee80211ScalarRadio
config *.robot[*].wlan[0].radio.bandName "\"2.4 GHz\""
config *.robot[*].wlan[0].radio.bandwidth 20MHz
config *.robot[*].wlan[0].radio.transmitter.power 1000mW
config *.robot[*].wlan[0].radio.receiver.sensitivity -100dBm
config *.robot[*].wlan[0].radio.receiver.energyDetection -100dBm
config *.robot[*].wlan[0].radio.receiver.snirThreshold 0dB
config *.robot[*].wlan[0].mac.typename Ieee80211Mac
config *.robot[*].wlan[0].mac.dcf.typename Dcf
config *.robot[*].wlan[0].mac.dcf.channelAccess.typename Dcaf
config *.robot[*].wlan[0].mgmt.typename Ieee80211MgmtAdhoc
config *.robot[*].wlan[0].agent.typename ""
config *.radioMedium.typename Ieee80211ScalarRadioMedium
config *.radioMedium.propagation.typename ConstantSpeedPropagation
config *.radioMedium.pathLoss.typename FreeSpacePathLoss
config *.radioMedium.backgroundNoise.power -110dBm
config *.robot[*].app[0].**.displayStringTextFormat "\"sent: %s, rcvd: %r\""
config *.robot[*].udp.**.displayStringTextFormat "\"sent: %s, rcvd: %r\""
config **.udp.verbose true
config **.ipv4.verbose true
config **.wlan[0].mac.verbose true
config **.wlan[0].radio.verbose true

