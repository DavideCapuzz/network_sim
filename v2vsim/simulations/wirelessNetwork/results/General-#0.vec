attr iterationvarsf ""
attr measurement ""
attr network WirelessNetwork
attr processid 90427
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../../../packages/inet/images
config description "Simple sim where two robots communicate wirelessly"
config network WirelessNetwork
config sim-time-limit 300s
config user-interface Qtenv
config cmdenv-express-mode true
config **.cmdenv-log-level info
config *.configurator.config "xml(\"<config><interface hosts='**' address='10.0.0.x' netmask='255.255.255.0'/></config>\")"
config *.robot*.numWlanInterfaces 1
config *.robot*.wlan[0].typename Ieee80211Interface
config *.robot*.wlan[0].radio.typename Ieee80211ScalarRadio
config *.robot*.wlan[0].radio.bandName "\"2.4 GHz\""
config *.robot*.wlan[0].radio.transmitter.power 2mW
config *.robot*.wlan[0].radio.receiver.sensitivity -85dBm
config *.robot*.wlan[0].radio.receiver.noiseFloor -110dBm
config *.robot*.wlan[0].radio.receiver.energyDetection -90dBm
config *.robot*.wlan[0].radio.receiver.ignoreInterference true
config *.robot*.wlan[0].mac.typename Ieee80211Mac
config *.robot*.wlan[0].mac.dcf.channelAccess.typename Dcaf
config *.robot*.wlan[0].mac.useAck false
config *.robot*.wlan[0].mac.fullDuplex false
config *.robot*.wlan[0].mac.headerLength 23B
config *.robot*.numApps 1
config *.robot*.app[0].typename UdpBasicApp
config *.robot*.app[0].localPort 5000
config *.robot*.app[0].destPort 5000
config *.robot*.app[0].externalHost "\"172.25.0.1\""
config *.robot*.app[0].externalPort 10000
config *.robot0.mobility.typename StationaryMobility
config *.robot0.mobility.initialX 200m
config *.robot0.mobility.initialY 300m
config *.robot0.mobility.initialZ 0m
config *.robot1.mobility.typename StationaryMobility
config *.robot1.mobility.initialX 400m
config *.robot1.mobility.initialY 300m
config *.robot1.mobility.initialZ 0m
config *.visualizer.*.mobilityVisualizer.displayPositions true
config *.visualizer.*.mobilityVisualizer.displayOrientations false
config *.visualizer.*.mobilityVisualizer.displayVelocities false
config *.visualizer.*.mobilityVisualizer.displayMovementTrails true
config *.visualizer.*.mediumVisualizer.displaySignals true
config *.visualizer.*.mediumVisualizer.displaySignalPropagation true
config *.visualizer.*.mediumVisualizer.displaySignalDepartures true
config *.visualizer.*.mediumVisualizer.displaySignalArrivals true
config *.visualizer.*.mediumVisualizer.signalShape "\"ring\""
config *.visualizer.*.mediumVisualizer.signalPropagationAnimationSpeed 5
config *.visualizer.*.physicalLinkVisualizer.displayLinks true
config *.visualizer.*.physicalLinkVisualizer.packetFilter "\"UDPData*\""
config *.radioMedium.backgroundNoiseLevel -110dBm
config *.radioMedium.pathLoss.alpha 2
config *.radioMedium.interferenceMode "\"ignore\""
config **.radio.displayCommunicationRange true

