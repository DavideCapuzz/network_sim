attr processid 78748
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../../../packages/inet/images
config network v2vsim.simulations.wirelessNetwork.WirelessNetwork
config description "Multi-robot wireless communication with Docker integration"
config sim-time-limit 300s
config cmdenv-express-mode true
config **.cmdenv-log-level info
config *.numRobots 2
config *.configurator.config "xml(\"<config><interface hosts='**' address='10.0.0.x' netmask='255.255.255.0'/></config>\")"
config *.robot[*].mobility.maxSpeed 10mps
config *.robot[*].mobility.externalHost "\"127.0.0.1\""
config *.robot[0].mobility.initialX 100m
config *.robot[0].mobility.initialY 300m
config *.robot[0].mobility.initialZ 0m
config *.robot[1].mobility.initialX 200m
config *.robot[1].mobility.initialY 300m
config *.robot[1].mobility.initialZ 0m
config *.robot[*].app[0].externalHost "\"127.0.0.1\""
config *.robot[*].numWlanInterfaces 1
config *.robot[*].wlan[0].typename Ieee80211Interface
config *.robot[*].wlan[0].radio.typename Ieee80211ScalarRadio
config *.robot[*].wlan[0].radio.bandName "\"2.4 GHz\""
config *.robot[*].wlan[0].radio.transmitter.power 20mW
config *.robot[*].wlan[0].radio.receiver.sensitivity -85dBm
config *.robot[*].wlan[0].radio.receiver.ignoreInterference false
config *.robot[*].wlan[0].radio.transmitter.communicationRange 200m
config *.robot[*].wlan[0].radio.displayCommunicationRange true
config *.robot[*].wlan[0].mac.typename Ieee80211Mac
config *.robot[*].wlan[0].mac.dcf.channelAccess.typename Dcaf
config *.visualizer.*.mobilityVisualizer.displayPositions true
config *.visualizer.*.mobilityVisualizer.displayOrientations true
config *.visualizer.*.mobilityVisualizer.displayVelocities true
config *.visualizer.*.mobilityVisualizer.displayMovementTrails true
config *.visualizer.*.mediumVisualizer.displayCommunicationRanges true
config *.visualizer.*.mediumVisualizer.displayInterferenceRanges false
config *.visualizer.*.mediumVisualizer.displaySignals true
config *.visualizer.*.mediumVisualizer.signalColor "\"yellow\""
config *.visualizer.*.mediumVisualizer.signalPropagationAnimationSpeed 1000
config *.visualizer.*.dataLinkVisualizer.displayLinks true
config *.visualizer.*.dataLinkVisualizer.packetFilter "\"wlan*\""
config *.radioMedium.propagation.typename ConstantSpeedPropagation
config *.radioMedium.pathLoss.typename FreeSpacePathLoss

