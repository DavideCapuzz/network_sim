# =====================================================================
# 1. IMPROVED Dockerfile (Based on your existing setup)
# =====================================================================
# FILE: Dockerfile
---
ARG VARIANT="22.04"
FROM ubuntu:${VARIANT} AS stage-base

ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:1 \
    VNC_RESOLUTION=1920x1080 \
    USER_NAME=ubuntu \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    QT_QPA_PLATFORM=xcb \
    SWT_GTK3=1

# ---------------------------------------------------------------------
# Base system & tools (SINGLE LINE - keeping your style)
# Added: networking tools, performance tools, build optimizations
# ---------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https ca-certificates \
    sudo wget curl git nano xz-utils unzip tini \
    build-essential cmake gdb make clang pkg-config ccache \
    bison flex libxml2-dev zlib1g-dev \
    python3 python3-pip python3-dev swig \
    # Networking tools for debugging
    net-tools iproute2 iputils-ping netcat socat tcpdump \
    # Performance monitoring
    htop iotop sysstat \
    # GUI stack
    fluxbox xterm xdg-utils \
    # Qt for Qtenv
    qtbase5-dev qtchooser qt5-qmake qtbase5-dev-tools libqt5opengl5-dev libqt5svg5-dev \
    # GTK/SWT deps (Eclipse-based OMNeT++ IDE)
    locales \
    libgtk-3-0 libgtk-3-bin libgtk-3-common \
    libglib2.0-0 libglib2.0-dev \
    libgdk-pixbuf-2.0-0 libgdk-pixbuf2.0-dev \
    libpango-1.0-0 libpangocairo-1.0-0 \
    libatk1.0-0 libatk-bridge2.0-0 \
    libx11-6 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxi6 libxinerama1 \
    libxrandr2 libxrender1 libxtst6 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    libglu1-mesa libgl1-mesa-glx \
    dbus-x11 \
    libcanberra-gtk3-module \
    libcanberra-gtk-module \
    # noVNC + proxy
    novnc websockify \
    # TigerVNC server + supervisord
    tigervnc-standalone-server tigervnc-common tigervnc-tools supervisor \
 && rm -rf /var/lib/apt/lists/*

# Enable ccache for faster rebuilds
ENV PATH="/usr/lib/ccache:${PATH}"
ENV CCACHE_DIR="/home/ubuntu/.ccache"

# ---------------------------------------------------------------------
# Locales
# ---------------------------------------------------------------------
RUN sed -i 's/^[# ]*en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen en_US.UTF-8 \
 && update-locale LANG=en_US.UTF-8

# ---------------------------------------------------------------------
# Create user (moved earlier for better caching)
# ---------------------------------------------------------------------
RUN groupadd --gid ${USER_GID} ${USER_NAME} \
 && useradd -m --uid ${USER_UID} --gid ${USER_GID} -s /bin/bash ${USER_NAME} \
 && echo "%${USER_NAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ---------------------------------------------------------------------
# Python stack (keeping your packages + adding extras)
# ---------------------------------------------------------------------
RUN python3 -m pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
    numpy scipy pandas matplotlib posix_ipc \
    redis asyncio

# ---------------------------------------------------------------------
# OMNeT++ (keeping your version)
# ---------------------------------------------------------------------
ARG OMNET_VERSION=6.0.1
ENV OMNET_ROOT=/opt/omnetpp-${OMNET_VERSION}
WORKDIR /opt

RUN wget -q --show-progress -O omnetpp-${OMNET_VERSION}-linux-x86_64.tgz \
      "https://github.com/omnetpp/omnetpp/releases/download/omnetpp-${OMNET_VERSION}/omnetpp-${OMNET_VERSION}-linux-x86_64.tgz" \
  ||  wget -q --show-progress -O omnetpp-${OMNET_VERSION}-linux-x86_64.tgz \
      "https://omnetpp.org/omnetpp-${OMNET_VERSION}-linux-x86_64.tgz" \
 && tar -xzf omnetpp-${OMNET_VERSION}-linux-x86_64.tgz \
 && rm omnetpp-${OMNET_VERSION}-linux-x86_64.tgz \
 && chown -R ${USER_NAME}:${USER_NAME} ${OMNET_ROOT}

# Make OMNeT++ tools available for everyone
RUN echo "source ${OMNET_ROOT}/setenv" >> /etc/bash.bashrc
ENV PATH="${OMNET_ROOT}/bin:${PATH}"

# ---------------------------------------------------------------------
# Build OMNeT++ (Qtenv + IDE) with optimizations
# ---------------------------------------------------------------------
USER ${USER_NAME}
WORKDIR ${OMNET_ROOT}
RUN . ./setenv \
 && ./configure \
      WITH_QTENV=yes \
      WITH_OSG=no \
      CFLAGS="-O3 -march=native -mtune=native" \
      CXXFLAGS="-O3 -march=native -mtune=native" \
 && make -j"$(nproc)" MODE=release NO_INSTALL_SHORTCUTS=yes

# ---------------------------------------------------------------------
# INET (keeping your version)
# ---------------------------------------------------------------------
ARG INET_VERSION=4.5.2
WORKDIR /home/${USER_NAME}/packages
RUN git clone --branch v${INET_VERSION} --depth 1 https://github.com/inet-framework/inet.git \
 && cd inet \
 && bash -lc ". ${OMNET_ROOT}/setenv && source ./setenv && make makefiles && make -j\"$(nproc)\" MODE=release"

# ---------------------------------------------------------------------
# Create workspace structure
# ---------------------------------------------------------------------
RUN mkdir -p /home/${USER_NAME}/src \
 && mkdir -p /home/${USER_NAME}/results \
 && mkdir -p /home/${USER_NAME}/.ccache \
 && chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME}

# ---------------------------------------------------------------------
# Install C++ aggregator dependencies
# ---------------------------------------------------------------------
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libboost-system-dev libboost-thread-dev libboost-program-options-dev \
    libhiredis-dev \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------
# noVNC entrypoint (keeping your approach)
# ---------------------------------------------------------------------
USER root
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
 && mkdir -p /etc/supervisor/conf.d

# Set proper ownership
RUN chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME}

USER ubuntu
WORKDIR /home/ubuntu/src

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]